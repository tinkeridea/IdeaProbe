# Zenith India Environment Configuration Template
# Duplicate this file to .env.local for local overrides.
# NOTE: Do NOT place raw LLM API keys (OpenAI, Anthropic, Gemini, etc.) in Vite frontend!
# All sensitive AI calls must pass through a secure backend proxy server.

# Base URL of the Zenith AI Backend service (once developed)
VITE_API_BASE_URL=http://localhost:5000/api

# Application Environment (development | staging | production)
VITE_APP_ENV=development
